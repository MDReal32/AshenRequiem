{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "@package": ["../dev/pack/.probe/@package"],
      "@package/*": ["../dev/pack/.probe/@package/*"],
      "@side-only/*": ["../dev/pack/.probe/@side-only/*"],
      "@special": ["../dev/pack/.probe/@special"],
      "@special/*": ["../dev/pack/.probe/@special/*"]
    }
  }
}
