{
  "extends": "./tsconfig.base.json",
  "include": [
    "src/server.ts",
    "src/server/**/*",
    "src/shared/server/**/*",
    "src/shared/common/**/*",
    "../dev/pack/.probe/@package/**/*.d.ts",
    "../dev/pack/.probe/@special/**/*.d.ts",
    "../dev/pack/.probe/@side-only/server/**/*.d.ts",
    // The dev pack joins a dedicated server, so ProbeJS never sees server scripts and dumps no server bindings.
    // Server scripts get the same bindings as startup ones (Cinematica, AR, Utils, ...), so those stand in.
    // Remove this line if a singleplayer dump ever adds .probe/@side-only/server/bindings.
    "../dev/pack/.probe/@side-only/startup/bindings/*.d.ts"
  ]
}
